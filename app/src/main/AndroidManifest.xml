<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineViewer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OfflineViewer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Appear in "Open with" for supported MIME types (VIEW). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/x-icon" />
                <data android:mimeType="image/vnd.microsoft.icon" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/vnd.wap.wbmp" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/heic" />
            </intent-filter>

            <!-- Appear in "Open with" by file extension when the MIME type is
                 generic/unknown (e.g. octet-stream). Matches the file name. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.svg" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\.tsv" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\.htm" />
                <data android:pathPattern=".*\\.rtf" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.jar" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\.gz" />
                <data android:pathPattern=".*\\.tgz" />
                <data android:pathPattern=".*\\.webp" />
                <data android:pathPattern=".*\\.bmp" />
                <data android:pathPattern=".*\\.gif" />
                <data android:pathPattern=".*\\.ico" />
                <data android:pathPattern=".*\\.wbmp" />
                <data android:pathPattern=".*\\.heif" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\.kt" />
                <data android:pathPattern=".*\\.kts" />
                <data android:pathPattern=".*\\.java" />
                <data android:pathPattern=".*\\.js" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.py" />
                <data android:pathPattern=".*\\.c" />
                <data android:pathPattern=".*\\.cpp" />
                <data android:pathPattern=".*\\.h" />
                <data android:pathPattern=".*\\.cs" />
                <data android:pathPattern=".*\\.go" />
                <data android:pathPattern=".*\\.rb" />
                <data android:pathPattern=".*\\.rs" />
                <data android:pathPattern=".*\\.php" />
                <data android:pathPattern=".*\\.swift" />
                <data android:pathPattern=".*\\.sh" />
                <data android:pathPattern=".*\\.sql" />
                <data android:pathPattern=".*\\.css" />
                <data android:pathPattern=".*\\.scss" />
                <data android:pathPattern=".*\\.less" />
                <data android:pathPattern=".*\\.toml" />
                <data android:pathPattern=".*\\.ini" />
                <data android:pathPattern=".*\\.cfg" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\.env" />
                <data android:pathPattern=".*\\.properties" />
                <data android:pathPattern=".*\\.scala" />
                <data android:pathPattern=".*\\.dart" />
                <data android:pathPattern=".*\\.lua" />
                <data android:pathPattern=".*\\.pl" />
                <data android:pathPattern=".*\\.r" />
                <data android:pathPattern=".*\\.groovy" />
                <data android:pathPattern=".*\\.gradle" />
                <data android:pathPattern=".*\\.ps1" />
                <data android:pathPattern=".*\\.bat" />
                <data android:pathPattern=".*\\.cmd" />
                <data android:pathPattern=".*\\.bash" />
                <data android:pathPattern=".*\\.zsh" />
            </intent-filter>

            <!-- Receive shared files from the share sheet (SEND). -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/x-icon" />
                <data android:mimeType="image/vnd.microsoft.icon" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/vnd.wap.wbmp" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/heic" />
            </intent-filter>
        </activity>

        <!-- Exposes app-private copies of the open file for sharing. Fully
             offline: grants read access only to this app's own files, so the
             share sheet receives a URI we actually own (no foreign-provider
             re-grant, no INTERNET permission). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
